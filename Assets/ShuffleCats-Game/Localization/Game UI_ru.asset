  - m_Id: 2573185030
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C \n\u043F\u0440\u043E\u0439\u0434\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185031
    m_Localized: "\u0412\u0441\u0435 \u0443\u0440\u043E\u0432\u043D\u0438 \n\u043F\u0440\u043E\u0439\u0434\u0435\u043D\u044B!"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185032
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C {0} \u043F\u0440\u043E\u0439\u0434\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185033
    m_Localized: "\u0414\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185034
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C\n\u0441\u043D\u043E\u0432\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185035
    m_Localized: "\u0417\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185036
    m_Localized: "\u0438\u0433\u0440\u0430\u0442\u044C \u0441 1 \u0443\u0440\u043E\u0432\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185037
    m_Localized: "\u043D\u0430\u0447\u0430\u0442\u044C \u0441 1 \u0443\u0440\u043E\u0432\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185038
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185039
    m_Localized: "\u041D\u0430\u0434\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185040
    m_Localized: "\u041D\u0430\u0434\u0435\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185041
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0451\u043C \u043A\u043E\u0442\u0438\u043A\u043E\u0432\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185042
    m_Localized: "\u041D\u0435\u0442 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438
      \u2014 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185043
    m_Localized: "\u0420\u0415\u0419\u0422\u0418\u041D\u0413"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185044
    m_Localized: "\u0421\u0430\u043C\u044B\u0439 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185045
    m_Localized: "\u0418\u0433\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185046
    m_Localized: "\u0423\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185047
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0441 \u042F\u043D\u0434\u0435\u043A\u0441
      ID"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185048
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185049
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043C \u0440\u0435\u0439\u0442\u0438\u043D\u0433..."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185050
    m_Localized: "\u041E\u0436\u0438\u0434\u0430\u0435\u043C \u0432\u0445\u043E\u0434\u0430..."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185051
    m_Localized: "\u0412\u0430\u0448 \u0440\u0435\u043A\u043E\u0440\u0434: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185052
    m_Localized: "\u0412\u0430\u0448\u0435 \u043C\u0435\u0441\u0442\u043E: #{0}  
      \u0420\u0435\u043A\u043E\u0440\u0434: {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185053
    m_Localized: "\u0412\u043E\u0439\u0434\u0438\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
      \u0438 \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u0441\u0432\u043E\u0451
      \u043C\u0435\u0441\u0442\u043E.\n\u041C\u043E\u0436\u043D\u043E \u0438\u0433\u0440\u0430\u0442\u044C
      \u0431\u0435\u0437 \u0432\u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185054
    m_Localized: "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D.
      \u041F\u043E\u0432\u0442\u043E\u0440\u0438\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185055
    m_Localized: "\u041F\u043E\u043A\u0430 \u043D\u0435\u0442 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u0432.
      \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0443\u0440\u043E\u0432\u0435\u043D\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185056
    m_Localized: "\u0420\u0435\u0439\u0442\u0438\u043D\u0433 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D
      \u0432 \u042F\u043D\u0434\u0435\u043A\u0441 \u0418\u0433\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185057
    m_Localized: "\u0420\u0435\u0439\u0442\u0438\u043D\u0433 \u043F\u043E\u043A\u0430
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185058
    m_Localized: "\u0412\u0445\u043E\u0434 \u043E\u0442\u043C\u0435\u043D\u0451\u043D.
      \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0438\u0433\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185059
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438\u0442\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0438 \u043E\u0431\u043D\u043E\u0432\u0438\u0442\u0435 \u0440\u0435\u0439\u0442\u0438\u043D\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185060
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u0440\u0435\u0439\u0442\u0438\u043D\u0433. \u041F\u0440\u043E\u0432\u0435\u0440\u044C\u0442\u0435
      \u0438\u043D\u0442\u0435\u0440\u043D\u0435\u0442 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2573185061
    m_Localized: "\u042F\u0417\u042B\u041A"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185062
    m_Localized: "\u0410\u0412\u0422\u041E"
    m_Metadata:
      m_Items: []
  - m_Id: 2573185063
    m_Localized: "\u0417\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 290981939228672
    m_Localized: "\u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 306994005127168
    m_Localized: "\u041F\u0438\u043A\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 306994009321472
    m_Localized: "\u0423\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 306994009321473
    m_Localized: "\u041E\u0431\u043B\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941037174784
    m_Localized: "\u041E\u0411\u0423\u0427\u0415\u041D\u0418\u0415  {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923520
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923521
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438 \u0441\u0432\u043E\u0439 \u0446\u0432\u0435\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923522
    m_Localized: "\u041A\u0430\u0436\u0434\u043E\u043C\u0443 \u043A\u043E\u0442\u0443
      \u043D\u0443\u0436\u043D\u044B \u043A\u043B\u0443\u0431\u043A\u0438 \u0435\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430. \u041D\u0430\u0436\u043C\u0438 \u043D\u0430
      \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u0442\u0430: \u043F\u0443\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923523
    m_Localized: "\u041F\u0443\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923524
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430\u0436\u043C\u0438
      \u043D\u0430 \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u0442\u0430. \u0423
      \u043A\u043E\u0440\u0437\u0438\u043D\u043E\u043A \u043A\u043E\u0442\u044B \u0441\u0430\u043C\u0438
      \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043A\u043B\u0443\u0431\u043A\u0430\u043C\u0438.
      \u0421\u043E\u0431\u0440\u0430\u0432 \u0432\u0441\u0435 \u043A\u043B\u0443\u0431\u043A\u0438
      \u0441\u0432\u043E\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430, \u043A\u043E\u0442
      \u0443\u0445\u043E\u0434\u0438\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923525
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923526
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u0432\u0441\u0435\u0433\u043E
      2 \u043C\u0435\u0441\u0442\u0430. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043D\u0430\u0436\u043C\u0438 \u043D\u0430 \u044D\u0442\u043E\u0433\u043E
      \u043A\u043E\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C \u043A\u043E\u0442\u0443 \u0437\u0430 \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923527
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043D\u0443\u0436\u043D\u044B\u0439
      \u0446\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923528
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u044D\u0442\u043E\u0433\u043E
      \u043A\u043E\u0442\u0430 \u2014 \u043E\u043D \u0441\u043E\u0431\u0435\u0440\u0451\u0442
      \u043A\u043B\u0443\u0431\u043A\u0438 \u0441\u0432\u043E\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430.
      \u0414\u0432\u0430 \u043A\u043E\u0442\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430 \u043C\u043E\u0433\u0443\u0442 \u0437\u0430\u043D\u044F\u0442\u044C
      \u0432\u0441\u044E \u0434\u043E\u0440\u043E\u0436\u043A\u0443 \u0438 \u0437\u0430\u0441\u0442\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923529
    m_Localized: "\u041E\u0441\u0442\u0430\u043B\u0441\u044F \u043E\u0434\u0438\u043D
      \u043A\u043E\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923530
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u0435\u0441\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E! \u041D\u0430\u0436\u043C\u0438 \u043D\u0430
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043A\u043E\u0442\u0430.
      \u0427\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0439\u0442\u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C,
      \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0432\u0441\u0435\u0445 \u043A\u043E\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923531
    m_Localized: "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2127941074923532
    m_Localized: "\u041A\u043E\u0442\u044B \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u0447\u0443\u0436\u0438\u0435 \u043A\u043B\u0443\u0431\u043A\u0438 \u0432
      \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0430\u0445 \u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442
      \u0441\u0432\u043E\u0438. \u041F\u043E\u0434\u043E\u0436\u0434\u0438, \u043F\u043E\u043A\u0430
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u044F\u0442\u0441\u044F \u043F\u0443\u0442\u044C
      \u0438 \u043C\u0435\u0441\u0442\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2137384860758016
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u0434\u0432\u0430
      \u043C\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2137384864952320
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u043F\u043E\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E 2 \u043A\u043E\u0442\u0430. \u041D\u0430\u0436\u043C\u0438
      \u043D\u0430 \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u0442\u0430: \u043E\u043D
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043A \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0430\u043C
      \u0437\u0430 \u043A\u043B\u0443\u0431\u043A\u0430\u043C\u0438 \u0441\u0432\u043E\u0435\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2137384864952321
    m_Localized: "\u041A\u043E\u0442\u044B \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u0447\u0443\u0436\u0438\u0435 \u043A\u043B\u0443\u0431\u043A\u0438 \u0432
      \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0430\u0445 \u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442
      \u043A\u043B\u0443\u0431\u043A\u0438 \u0441\u0432\u043E\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430.
      \u0421\u043E\u0431\u0440\u0430\u0432 \u0432\u0441\u0435 \u0441\u0432\u043E\u0438
      \u043A\u043B\u0443\u0431\u043A\u0438, \u043A\u043E\u0442 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0441 \u0434\u043E\u0440\u043E\u0436\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2137384864952322
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2137384864952323
    m_Localized: "\u0416\u0434\u0451\u043C \u043C\u0435\u0441\u0442\u043E \u043D\u0430
      \u0434\u043E\u0440\u043E\u0436\u043A\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731804307456
    m_Localized: "\u0421\u0447\u0451\u0442\u0447\u0438\u043A \u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501760
    m_Localized: "0/2 \u2014 \u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435
      \u043F\u043E\u043A\u0430 \u043D\u0435\u0442 \u043A\u043E\u0442\u043E\u0432,
      \u0430 \u043F\u043E\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F \u0434\u0432\u043E\u0435.
      \u0427\u0438\u0441\u043B\u043E \u0441\u043F\u0440\u0430\u0432\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0442\u043E\u0432 \u043C\u043E\u0433\u0443\u0442
      \u0435\u0445\u0430\u0442\u044C \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501761
    m_Localized: "\u0412\u043E\u0442 \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501762
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043A\u043E\u0442\u044B \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u0447\u0443\u0436\u0438\u0435 \u043A\u043B\u0443\u0431\u043A\u0438 \u0438
      \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442 \u0441\u0432\u043E\u0438.
      \u0421\u043E\u0431\u0440\u0430\u0432 \u0432\u0441\u0435 \u043A\u043B\u0443\u0431\u043A\u0438
      \u0441\u0432\u043E\u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430, \u043A\u043E\u0442
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0441 \u0434\u043E\u0440\u043E\u0436\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501763
    m_Localized: "\u041F\u043E\u043C\u043E\u0433\u0438 \u0432\u0442\u043E\u0440\u043E\u043C\u0443
      \u043A\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501764
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u044C
      \u044D\u0442\u043E\u0433\u043E \u043A\u043E\u0442\u0430 \u0437\u0430 \u043A\u043B\u0443\u0431\u043A\u0430\u043C\u0438
      \u0435\u0433\u043E \u0446\u0432\u0435\u0442\u0430. \u0427\u0442\u043E\u0431\u044B
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C,
      \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0432\u0441\u0435\u0445 \u043A\u043E\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501765
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043C \u043D\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501766
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u044C \u044D\u0442\u043E\u0433\u043E
      \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E \u043A\u043E\u0442\u0430.
      \u0417\u0430\u0439\u043C\u0451\u043C \u043E\u0431\u0430 \u043C\u0435\u0441\u0442\u0430
      \u0437\u0435\u043B\u0451\u043D\u044B\u043C\u0438 \u043A\u043E\u0442\u0430\u043C\u0438
      \u0438 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C, \u0447\u0442\u043E
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501767
    m_Localized: "\u0417\u0430\u0439\u043C\u0438 \u0432\u0442\u043E\u0440\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501768
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u044C \u0438 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E \u043A\u043E\u0442\u0430.
      \u041E\u0431\u0430 \u043C\u0435\u0441\u0442\u0430 \u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435
      \u0431\u0443\u0434\u0443\u0442 \u0437\u0430\u043D\u044F\u0442\u044B, \u0430
      \u0441\u0438\u043D\u0438\u0439 \u043A\u043E\u0442 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501769
    m_Localized: "\u0421\u043B\u0435\u0434\u0438\u043C \u0437\u0430 \u043A\u043E\u0442\u0430\u043C\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501770
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043A\u043E\u0442\u044B \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501771
    m_Localized: "\u041E\u0431\u0430 \u043C\u0435\u0441\u0442\u0430 \u0437\u0430\u043D\u044F\u0442\u044B
      \u0437\u0435\u043B\u0451\u043D\u044B\u043C\u0438 \u043A\u043E\u0442\u0430\u043C\u0438.
      \u041D\u0443\u0436\u043D\u044B\u0435 \u0438\u043C \u0437\u0435\u043B\u0451\u043D\u044B\u0435
      \u043A\u043B\u0443\u0431\u043A\u0438 \u0443 \u0441\u0438\u043D\u0435\u0433\u043E
      \u043A\u043E\u0442\u0430, \u043D\u043E \u0435\u043C\u0443 \u043D\u0435\u0433\u0434\u0435
      \u0435\u0445\u0430\u0442\u044C. \u041D\u0430\u0447\u043D\u0451\u043C \u0437\u0430\u043D\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501772
    m_Localized: "\u041D\u0430\u0447\u043D\u0438 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501773
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \xAB\u0417\u0430\u043D\u043E\u0432\u043E\xBB.
      \u0417\u0430\u0442\u0435\u043C \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u043C
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0442\u044C
      \u0434\u043E\u0440\u043E\u0436\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501774
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501775
    m_Localized: "\u041D\u0430\u0447\u043D\u0438 \u0441 \u044D\u0442\u043E\u0433\u043E
      \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E \u043A\u043E\u0442\u0430.
      \u041D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437 \u043E\u0441\u0442\u0430\u0432\u044C
      \u0432\u0442\u043E\u0440\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u043D\u0430
      \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u0434\u043B\u044F \u0441\u0438\u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501776
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u044C
      \u0441\u0438\u043D\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 2146731808501777
    m_Localized: "\u0423 \u0441\u0438\u043D\u0435\u0433\u043E \u043A\u043E\u0442\u0430
      \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u043A\u043B\u0443\u0431\u043A\u0438,
      \u0430 \u043D\u0443\u0436\u043D\u044B \u0441\u0438\u043D\u0438\u0435. \u0412\u043C\u0435\u0441\u0442\u0435
      \u043A\u043E\u0442\u044B \u0440\u0430\u0437\u043D\u044B\u0445 \u0446\u0432\u0435\u0442\u043E\u0432
      \u0441\u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0441\u0432\u043E\u0438 \u043A\u043B\u0443\u0431\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2160169884561408
    m_Localized: "\u0414\u043E\u0440\u043E\u0436\u043A\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2160169892950016
    m_Localized: "2/2 \u2014 \u043E\u0431\u0430 \u043C\u0435\u0441\u0442\u0430 \u0437\u0430\u043D\u044F\u0442\u044B.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043A\u043E\u0442 \u0441\u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0435\u0445\u0430\u0442\u044C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u0433\u0434\u0430 \u043E\u0434\u0438\u043D \u0438\u0437 \u043A\u043E\u0442\u043E\u0432
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u0441\u043E\u0431\u0435\u0440\u0451\u0442
      \u0432\u0441\u0435 \u0441\u0432\u043E\u0438 \u043A\u043B\u0443\u0431\u043A\u0438
      \u0438 \u0443\u0439\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2166080854274048
    m_Localized: "\u0417\u0435\u043B\u0451\u043D\u044B\u043C \u043A\u043E\u0442\u0430\u043C
      \u043D\u0443\u0436\u043D\u044B \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u043A\u043B\u0443\u0431\u043A\u0438,
      \u0430 \u0432 \u043A\u043E\u0440\u0437\u0438\u043D\u043A\u0435 \u2014 \u0441\u0438\u043D\u0438\u0435.
      \u0417\u0435\u043B\u0451\u043D\u044B\u0435 \u043A\u043B\u0443\u0431\u043A\u0438
      \u0443 \u0441\u0438\u043D\u0435\u0433\u043E \u043A\u043E\u0442\u0430, \u043D\u043E
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0436\u043A\u0435 \u043D\u0435\u0442
      \u043C\u0435\u0441\u0442\u0430. \u041D\u0430\u0447\u043D\u0451\u043C \u0437\u0430\u043D\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2166080854274049
    m_Localized: "\u041E\u0442\u043A\u0440\u043E\u0439 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2166080854274050
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u0448\u0435\u0441\u0442\u0435\u0440\u0451\u043D\u043A\u0443.
      \u0412 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445 \u0435\u0441\u0442\u044C
      \u043A\u043D\u043E\u043F\u043A\u0430 \xAB\u0417\u0430\u043D\u043E\u0432\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 2173509885210624
    m_Localized: "\u0417\u0435\u043B\u0451\u043D\u043E\u043C\u0443 \u043A\u043E\u0442\u0443
      \u043D\u0443\u0436\u043D\u044B \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u043A\u043B\u0443\u0431\u043A\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0439\u0442\u0438 \u0441 \u0434\u043E\u0440\u043E\u0436\u043A\u0438.
      \u041E\u0442\u043F\u0440\u0430\u0432\u044C \u0441\u0438\u043D\u0435\u0433\u043E
      \u043A\u043E\u0442\u0430 \u2014 \u043E\u043D \u0438\u0445 \u0432\u0435\u0437\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2178074089074688
    m_Localized: "\u041D\u0443\u0436\u043D\u0430 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2178074093268992
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 \u043D\u0430 \u043B\u0430\u043C\u043F\u043E\u0447\u043A\u0443
      \u2014 \u043E\u043D\u0430 \u0432\u044B\u0434\u0435\u043B\u0438\u0442 \u043A\u043E\u0442\u0430,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043C\u043E\u0436\u043D\u043E
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C.
      \u041F\u043E\u043B\u044C\u0437\u0443\u0439\u0441\u044F \u0435\u0439, \u043A\u043E\u0433\u0434\u0430
      \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2178074093268993
    m_Localized: "\u041B\u0430\u043C\u043F\u043E\u0447\u043A\u0430 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442
      \u043A\u043E\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C. \u041F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438
      \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u044B \u2014 \u0438\u0445
      \u043C\u043E\u0436\u043D\u043E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0432 \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
